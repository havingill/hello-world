# Copy to .env and fill in. Without these the dashboard still runs; only the
# chatbot falls back to its offline keyword responder.

# Your Azure AI Foundry endpoint. Either shape works:
#   https://<resource>.openai.azure.com/
#   https://<resource>.services.ai.azure.com/
AZURE_AI_ENDPOINT=

# The model deployment name from your Foundry project (not the model name).
AZURE_AI_DEPLOYMENT=gpt-4o

# Optional. Leave blank to authenticate with Entra ID instead — managed identity
# when hosted in Azure, `az login` when running locally. Prefer that in anything
# beyond local development.
AZURE_AI_API_KEY=

AZURE_AI_API_VERSION=2024-10-21

# Chatbot tuning.
CHAT_MAX_TOOL_ITERATIONS=5
CHAT_TEMPERATURE=0.2
